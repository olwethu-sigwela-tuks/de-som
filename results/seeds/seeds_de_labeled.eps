%
% PS header for umat - SOM to PS converter
% Version 1.1 Wed June 28 1995
% Author: Jussi Hynninen <hynde@nucleus.hut.fi>
100 dict begin

% predefine variables
/yoff 0 def /xoff 0 def /xstep 0 def /ystep 0 def /y 0 def /radius 0 def
/yoffset 0 def /xoffset 0 def
/picwidth 0 def /picheight 0 def
/doborder false def
% default font
/fontname /Helvetica def
% font size relative to radius
/fontsize 0.60 def

% default black and white tresholds
/bt 0.0 def /wt 1.0 def

% labelpallon sade suhteessa hexan sateeseen
/ballrad 0.2 def

% newline function. Moves the y coordinate to the next line
/NL 
{ /yoff yoff ystep sub def % next row
  /y y 1 add def % add y by one
  } bind def

% start of line (for hexagonal lattice) - moves the current position in 
% x direction to the correct place of the line
/XSH
{ xoff 
  y 4 mod
  dup 3 eq {pop 1} if
  xstep 2 div mul
  add
  yoff moveto % move to start of line
} bind def

% start of line (for rectangular lattice) - moves the current position in 
% x direction to the correct place of the line
/XSR { xoff yoff moveto } bind def

% set label color. If block is light -> label is black and same for dark block
/sbc { 0 setgray } bind def

% set gray level
/G { 
  100 div dup bt le {pop 0}
  { dup wt ge {pop 1} {bt sub wt bt sub div} ifelse
  } ifelse
} bind def

% unlabelled node
/LN { 
  gsave
  G sbc
  currentpoint radius ballrad mul 0 360 arc fill 
  grestore
  xstep 2 mul 0 rmoveto
} bind def

%select font
/selfont {
  fontname findfont radius fontsize mul scalefont setfont
} bind def

% print single label

/LAB { 
  gsave
  dup 50 lt { 1 setgray } { 0 setgray } ifelse
  exch dup stringwidth pop 2 div neg fontsize radius mul 0.35 mul neg rmoveto
  show
  grestore
  xstep 2 mul 0 rmoveto
} bind def

% print multiple labels on one unit
/ML {
  gsave
  G sbc
  /numlabs exch def %number of labels
  numlabs
  2 div 
  0.25 sub
  radius fontsize mul mul neg
  0 exch rmoveto
  1 1 numlabs {
    pop
    gsave
    dup %duplicate string  
    stringwidth
    pop 
    -2 div 0
    rmoveto
    show
    grestore
    0 fontsize radius mul rmoveto
  } for 
  grestore
  xstep 2 mul 0 rmoveto
} bind def

% print hexagon
/H { 
  gsave
  G dup setgray
  currentpoint translate
  newpath 0 radius moveto
  5 {60 rotate 0 radius lineto} repeat
  closepath
  doborder { gsave fill grestore 0 setgray stroke pop }
           { fill pop } ifelse
  grestore  
  xstep 0 rmoveto
} bind def

% print rectangle
/R {
  gsave
  G dup setgray %duplicate gray level
  currentpoint translate
  newpath
  xstep 0.5 mul dup moveto
  xstep neg 0 rlineto
  0 xstep neg rlineto
  xstep 0 rlineto
  closepath
  doborder { gsave fill grestore sbc stroke}
           { fill pop } ifelse
  grestore  
  xstep 0 rmoveto
} bind def

% swap x
/swapx {
/xstep xstep neg def
/xoffset picwidth xoffset sub def
} bind def

%swap y
/swapy {
/ystep ystep neg def
/yoffset picheight yoffset sub def
} bind def

1 setlinewidth

% End of umat PS header
% Start image


/radius 36.084392 def
/xstep 62.500000 def
/ystep 54.126588 def
/picwidth 1000.000000 def /picheight 613.434661 def
%%IncludeFont: Helvetica
/fontname /Helvetica def
selfont
/doborder true def
/wt 1.000000 def /bt 0.000000 def
/xoffset 31.250000 def /yoffset 577.350269 def
/y 0 def
/xoff xoffset def
/yoff yoffset def
XSH 51 H 51 H 66 H 60 H 65 H 57 H 72 H 86 H 83 H 95 H 67 H 62 H 73 H 82 H 82 H NL
XSH 50 H 76 H 71 H 69 H 75 H 69 H 76 H 80 H 52 H 53 H 71 H 71 H 74 H 88 H 31 H NL
XSH 62 H 72 H 70 H 77 H 76 H 90 H 78 H 57 H 45 H 38 H 69 H 66 H 73 H 15 H 29 H NL
XSH 62 H 59 H 57 H 59 H 53 H 91 H 100 H 43 H 30 H 20 H 59 H 77 H 81 H 71 H 29 H NL
XSH 53 H 53 H 58 H 95 H 57 H 55 H 93 H 38 H 44 H 45 H 56 H 53 H 77 H 76 H 71 H NL
XSH 40 H 67 H 47 H 42 H 62 H 96 H 97 H 47 H 55 H 67 H 59 H 62 H 89 H 74 H 67 H NL
XSH 42 H 42 H 41 H 41 H 57 H 96 H 93 H 89 H 83 H 76 H 61 H 50 H 71 H 87 H 67 H NL
XSH 63 H 42 H 36 H 0 H 51 H 52 H 55 H 97 H 96 H 98 H 77 H 61 H 68 H 56 H 60 H NL
XSH 65 H 65 H 45 H 42 H 39 H 37 H 59 H 63 H 85 H 93 H 83 H 74 H 68 H 75 H 60 H NL
XSH 79 H 53 H 48 H 40 H 30 H 78 H 88 H 77 H 50 H 48 H 90 H 66 H 68 H 59 H 91 H NL
XSH 79 H 82 H 65 H 84 H 81 H 86 H 81 H 48 H 48 H 46 H 65 H 63 H 61 H 45 H 68 H NL
/y 0 def
/xoff xoffset def
/yoff yoffset def
XSH (Kam) 51 LAB (Ros) 66 LAB (Kam) 65 LAB (Ros) 72 LAB (Kam) 83 LAB (Kam) 67 LAB (Ros) 73 LAB (Ros) 82 LAB NL NL
XSH (Kam) 62 LAB (Can) 70 LAB (Kam) 76 LAB (Can) 78 LAB (Ros) 45 LAB (Ros) 69 LAB (Ros) 73 LAB (Kam) 29 LAB NL NL
XSH (Can) 53 LAB (Ros) 58 LAB (Ros) 57 LAB (Can) 93 LAB (Ros) 44 LAB (Kam) 56 LAB (Kam) 77 LAB (Ros) 71 LAB NL NL
XSH (Ros) 42 LAB (Ros) 41 LAB (Can) 57 LAB (Kam) 93 LAB (Kam) 83 LAB (Kam) 61 LAB (Ros) 71 LAB (Ros) 67 LAB NL NL
XSH (Ros) 65 LAB (Can) 45 LAB (Can) 39 LAB (Ros) 59 LAB (Kam) 85 LAB (Kam) 83 LAB (Kam) 68 LAB (Can) 60 LAB NL NL
XSH (Kam) 79 LAB (Ros) 65 LAB (Ros) 81 LAB (Ros) 81 LAB (Ros) 48 LAB (Kam) 65 LAB (Ros) 61 LAB (Can) 68 LAB NL NL
end
% end of EPS object
